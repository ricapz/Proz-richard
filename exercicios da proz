<?php
$dia =readline("digite um numero de 1 a 7: ");
switch ($dia) {
    case '1':
        echo "Domingo";
        break;
    case '2':
        echo "Segunda";
        break;
    case '3':
        echo "terça";
        break;
    case '4':
        echo "quarta";
        break;
    case '5':
        echo "quinta";
        break;
    case '6':
        echo "sexta";
        break;
    case '7':
        echo "sabado";
        break;
    
    default:
        echo "Outro dia qualquer.";
        break;
}
?>
